# ============================================================
# Hybrid RAG Engine - Environment Variables
# Copy this file to `.env` and fill in your values.
# ============================================================

# ---------- REQUIRED ----------
# Google Gemini API key (get one at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------- OCR ----------
# Path to tesseract binary (leave as "tesseract" if installed system-wide)
TESSERACT_CMD=tesseract

# ---------- CHUNKING ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ---------- RETRIEVAL ----------
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
MAX_CONTEXT_TOKENS=4000